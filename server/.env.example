# Copiá este archivo como `.env` y completá los valores. NUNCA subas el .env real a git.

PORT=3000

# --- Mercado Pago ---
# TEST para desarrollar (sandbox, sin cobrar de verdad) o PRODUCCIÓN para cobrar real.
# Panel: https://www.mercadopago.com.ar/developers → Tus integraciones → Credenciales
MP_ACCESS_TOKEN=TEST-xxxxxxxx-xxxxxx-xxxxxxxxxxxx-xxxxxxxxx
MP_PUBLIC_KEY=TEST-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# --- URLs ---
SITE_URL=http://localhost:4321
# En dev, la URL pública del túnel (ngrok/cloudflared) que apunta a este backend.
API_URL=https://TU-TUNEL.ngrok-free.app

# --- Descargas firmadas (generá uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))") ---
DOWNLOAD_SECRET=cambiame-por-un-secreto-largo-aleatorio
DOWNLOAD_TTL_HOURS=72
# Links que van por email: duran más (default 30 días).
EMAIL_DOWNLOAD_TTL_HOURS=720

# --- Email (Resend: https://resend.com → API Keys) ---
# Si RESEND_API_KEY queda vacío, NO se envían emails (la descarga en pantalla sigue funcionando).
RESEND_API_KEY=
# Remitente. Para producción, verificá tu dominio en Resend y usá algo como "Victoria Citro <hola@victoriacitro.net>".
# Para probar sin dominio propio, podés usar "onboarding@resend.dev".
MAIL_FROM=Victoria Citro <onboarding@resend.dev>
# Opcional: a dónde responden los clientes.
MAIL_REPLY_TO=
BRAND_NAME=Victoria Citro

# --- Panel de reportes ---
ADMIN_USER=victoria
ADMIN_PASS=cambiame

# --- Generación de preview "Kit Mundial" con IA (OpenAI) ---
# API key de OpenAI (https://platform.openai.com → API Keys). Con crédito cargado.
# Si queda vacío, el sitio funciona igual pero sin generar imagen (fallback a WhatsApp).
OPENAI_API_KEY=
# Modelo de imágenes. Default: gpt-image-1-mini (más nuevo y ~50-70% más barato que gpt-image-1,
# que además OpenAI discontinúa el 23-oct-2026). Alternativas si algo no anda con images/edits:
#   gpt-image-1.5   → más caro, mejor calidad
#   gpt-image-1     → legacy (más caro, se discontinúa 23-oct-2026)
OPENAI_IMAGE_MODEL=gpt-image-1-mini
# Calidad del render: low | medium | high.
#   low    → lo más barato/rápido (para tests)
#   medium → equilibrio costo/calidad
#   high   → mejor detalle y MENOS errores anatómicos (patas/ojos de más, deformaciones).
#            Default recomendado. Con gpt-image-1-mini a 1536x1024 sale ~$0.05/img.
OPENAI_IMAGE_QUALITY=high
OPENAI_IMAGE_SIZE=1536x1024
# Carpeta donde se guardan los previews generados (nuestro respaldo). Por defecto server/data/kit-previews
# KIT_PREVIEWS_DIR=./data/kit-previews

# --- Meta (Facebook) Pixel + Conversions API ---
# El Pixel ID es público (default ya cargado en el código). El Access Token es SECRETO.
# Generá el token en: Meta Events Manager → tu pixel → Configuración → Conversions API → Generar token.
# Si META_CAPI_TOKEN queda vacío, el pixel del navegador funciona igual, pero NO se envía
# el Purchase server-side (Conversions API) ni hay deduplicación por CAPI.
META_PIXEL_ID=1670887204183026
META_CAPI_TOKEN=
META_API_VERSION=v21.0
# Para probar SIN contar conversiones reales: pegá el código de "Probar eventos" de Events Manager.
# Dejalo VACÍO en producción.
META_TEST_EVENT_CODE=

# --- Otros ---
CURRENCY=ARS
# PRIVATE_EBOOKS_DIR=../private-ebooks
# DB_PATH=./data/sales.db

# Monto máximo (ARS) permitido para el link de pago a precio negociado (/api/checkout/link).
# Sólo lo usa el endpoint protegido con ADMIN_USER/ADMIN_PASS. Evita cobros absurdos por error de tipeo.
# MAX_CUSTOM_AMOUNT_ARS=5000000
