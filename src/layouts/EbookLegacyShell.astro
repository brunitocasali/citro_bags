---
/**
 * Documento HTML completo para la landing legacy de /ebooks
 * (sin global.css de la home para no pisar estilos del diseño original).
 */
import MetaPixel from '../components/MetaPixel.astro';
import { getMainEbook } from '../data/ebookProducts';

export interface Props {
	title: string;
	description?: string;
	headHtml: string;
	bodyHtml: string;
}

const { title, description = '', headHtml, bodyHtml } = Astro.props;

const main = getMainEbook();
const viewContentData = {
	content_ids: [main.slug],
	content_name: main.title,
	content_type: 'product',
	currency: 'ARS',
	value: main.priceArs ?? 0,
};
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<link rel="icon" href="/ebook/favicon-vc.png" type="image/png" />
		<link rel="apple-touch-icon" href="/ebook/favicon-vc.png" />
		<title>{title}</title>
		<MetaPixel event="ViewContent" eventData={viewContentData} />
		<Fragment set:html={headHtml} />
	</head>
	<body>
		<div id="ebook-legacy-root" set:html={bodyHtml} />
	</body>
</html>
