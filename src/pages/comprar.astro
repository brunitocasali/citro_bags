---
import { getMainEbook, getBonuses, getUpsells, formatArs } from '../data/ebookProducts';
import MetaPixel from '../components/MetaPixel.astro';

const main = getMainEbook();
const bonuses = getBonuses();
const upsells = getUpsells();
const mainPrice = main.priceArs ?? 0;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Tu pedido · {main.title}</title>
    <MetaPixel />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,400..700;1,400..700&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/ebooks/css/ebooks-landing.css" />
    <link rel="stylesheet" href="/ebooks/css/cart.css" />
    <link rel="icon" href="/ebook/favicon-vc.png" type="image/png" />
    <style>
      /* Estados de validación del email (UX de error claro y visible). */
      .vc-cart__box input[type='email'].is-invalid {
        border-color: #d64545;
        background: #fff7f7;
      }
      .vc-cart__box input[type='email'].is-invalid:focus {
        border-color: #d64545;
        box-shadow: 0 0 0 3px rgba(214, 69, 69, 0.18);
      }
      .vc-cart__error {
        display: flex;
        align-items: flex-start;
        gap: 0.4rem;
        margin: -0.6rem 0 1rem;
        color: #c0392b;
        font-size: 0.85rem;
        font-weight: 600;
        line-height: 1.35;
      }
      .vc-cart__error::before {
        content: '⚠';
        flex-shrink: 0;
      }
      .vc-cart__note.is-error {
        color: #c0392b;
        font-weight: 600;
      }
      .vc-btn[disabled] {
        opacity: 0.65;
        cursor: progress;
      }
    </style>
  </head>
  <body>
    <div class="vc-page">
      <header class="vc-header">
        <div class="vc-header__inner">
          <a class="vc-brand" href="/ebooks">
            <span class="vc-brand__name">Victoria Citro</span>
            <span class="vc-brand__tag">Arte &amp; duelo</span>
          </a>
        </div>
      </header>

      <section class="vc-cart">
        <div class="vc-cart__box">
          <div class="vc-cart__head">
            <h1>Tu pedido</h1>
            <p>Revisá tu compra antes de pagar</p>
          </div>

          <!-- Ebook principal -->
          <div class="vc-cart__main" data-slug={main.slug} data-price={mainPrice}>
            <img src={main.cover} alt={main.title} width="70" height="105" loading="eager" />
            <div class="vc-cart__info">
              <strong>{main.title}</strong>
              <span class="vc-cart__tag">Acceso digital inmediato</span>
            </div>
            <div class="vc-cart__price">
              {main.regularPriceArs && <s>{formatArs(main.regularPriceArs)}</s>}
              <b>{formatArs(mainPrice)}</b>
            </div>
          </div>

          {
            bonuses.length > 0 && (
              <div class="vc-cart__bonuses">
                <p class="vc-cart__label">🎁 Bonos incluidos gratis</p>
                {bonuses.map((b) => (
                  <div class="vc-cart__bonus">
                    <img src={b.cover} alt={b.title} width="42" height="56" loading="lazy" />
                    <span>{b.title}</span>
                    <em>
                      {b.regularPriceArs && <s>{formatArs(b.regularPriceArs)}</s>} GRATIS
                    </em>
                  </div>
                ))}
              </div>
            )
          }

          {
            upsells.length > 0 && (
              <div class="vc-cart__upsells">
                <p class="vc-cart__label">Mejorá tu compra</p>
                {upsells.map((u) => (
                  <label class="vc-cart__upsell">
                    <input type="checkbox" class="vc-upsell" data-slug={u.slug} data-price={u.upsellPriceArs} />
                    <img src={u.cover} alt={u.title} width="56" height="80" loading="lazy" />
                    <div class="vc-cart__info">
                      <strong>{u.title}</strong>
                      <span class="vc-cart__tag">{u.description}</span>
                    </div>
                    <div class="vc-cart__price">
                      {u.regularPriceArs && <s>{formatArs(u.regularPriceArs)}</s>}
                      <b>
                        {u.upsellPriceArs === 0
                          ? 'GRATIS'
                          : u.upsellPriceArs != null
                            ? formatArs(u.upsellPriceArs)
                            : ''}
                      </b>
                    </div>
                  </label>
                ))}
              </div>
            )
          }

          <div class="vc-cart__total">
            <span>Total</span>
            <b id="vc-total">{formatArs(mainPrice)}</b>
          </div>

          <label class="vc-cart__emaillabel" for="vc-email">Tu email (te enviamos el acceso)</label>
          <input
            id="vc-email"
            type="email"
            inputmode="email"
            placeholder="tu@email.com"
            autocomplete="email"
            aria-describedby="vc-email-error"
            aria-invalid="false"
          />
          <p class="vc-cart__error" id="vc-email-error" role="alert" hidden></p>

          <button id="vc-pay" class="vc-btn vc-btn--solid" type="button">Pagar</button>
          <p class="vc-cart__note" id="vc-msg">🔒 Pago seguro procesado por Mercado Pago · Garantía de 7 días</p>
        </div>
      </section>
    </div>

    <script>
      const apiBase =
        location.hostname === 'localhost' || location.hostname === '127.0.0.1' ? 'http://localhost:4000' : '';
      const fmt = (n) => '$' + Number(n).toLocaleString('es-AR');
      const mainEl = document.querySelector('.vc-cart__main');
      const mainSlug = mainEl.dataset.slug;
      const mainPriceVal = Number(mainEl.dataset.price);

      function currentItems() {
        const items = [mainSlug];
        document.querySelectorAll('.vc-upsell:checked').forEach((el) => items.push(el.dataset.slug));
        return items;
      }
      function currentTotal() {
        let total = mainPriceVal;
        document.querySelectorAll('.vc-upsell:checked').forEach((el) => (total += Number(el.dataset.price)));
        return total;
      }

      function recalc() {
        document.getElementById('vc-total').textContent = fmt(currentTotal());
      }
      document.querySelectorAll('.vc-upsell').forEach((el) => el.addEventListener('change', recalc));

      // --- Validación de email con feedback visible ---
      const emailEl = document.getElementById('vc-email');
      const emailError = document.getElementById('vc-email-error');
      const EMAIL_RE = /^[^@\s]+@[^@\s]+\.[^@\s]+$/;

      function showEmailError(text) {
        emailError.textContent = text;
        emailError.hidden = false;
        emailEl.classList.add('is-invalid');
        emailEl.setAttribute('aria-invalid', 'true');
      }
      function clearEmailError() {
        emailError.hidden = true;
        emailError.textContent = '';
        emailEl.classList.remove('is-invalid');
        emailEl.setAttribute('aria-invalid', 'false');
      }
      function validateEmail() {
        const v = emailEl.value.trim();
        if (!v) {
          showEmailError('Ingresá tu email para recibir el acceso a la guía.');
          return false;
        }
        if (!EMAIL_RE.test(v)) {
          showEmailError('Ese email no parece válido. Revisalo, por favor (ej: nombre@correo.com).');
          return false;
        }
        clearEmailError();
        return true;
      }
      emailEl.addEventListener('input', () => {
        if (!emailError.hidden) clearEmailError();
      });
      emailEl.addEventListener('blur', () => {
        if (emailEl.value.trim()) validateEmail();
      });

      // Meta: comienzo del checkout (al cargar la página del carrito).
      if (window.vcMeta) {
        window.vcMeta.track('InitiateCheckout', {
          value: currentTotal(),
          currency: 'ARS',
          content_ids: currentItems(),
          content_type: 'product',
          num_items: currentItems().length,
        });
      }

      document.getElementById('vc-pay').addEventListener('click', async () => {
        const msg = document.getElementById('vc-msg');
        msg.classList.remove('is-error');
        if (!validateEmail()) {
          emailEl.focus();
          emailEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
          return;
        }
        const email = emailEl.value.trim();
        const items = currentItems();

        // Meta: el usuario avanza a pagar (todavía NO es Purchase).
        if (window.vcMeta) {
          window.vcMeta.track('AddPaymentInfo', {
            value: currentTotal(),
            currency: 'ARS',
            content_ids: items,
            content_type: 'product',
          });
        }

        const tracking = window.vcMeta ? window.vcMeta.tracking() : {};

        const btn = document.getElementById('vc-pay');
        btn.disabled = true;
        msg.textContent = 'Redirigiendo a Mercado Pago…';
        try {
          const res = await fetch(apiBase + '/api/checkout', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ items, email, tracking }),
          });
          const data = await res.json();
          if (!res.ok || !data.initPoint) throw new Error(data.error || 'Error al crear el pago.');
          window.location.href = data.initPoint;
        } catch (e) {
          msg.textContent = e.message || 'No se pudo iniciar el pago. Intentá de nuevo.';
          msg.classList.add('is-error');
          btn.disabled = false;
        }
      });
    </script>
  </body>
</html>
