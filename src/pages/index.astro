---
import Layout from '../layouts/Layout.astro';
import OrderDialog from '../components/OrderDialog.astro';
import VcAutoscroll from '../components/VcAutoscroll.astro';
---

<Layout
	title="Victoria Citro | Bolsos de lujo pintados a mano"
	description="Bolsos de lujo pintados a mano, murales y arte fino."
>
	<header class="site-header">
		<div class="site-header__inner">
			<a class="site-header__brand" href="#inicio">Victoria Citro</a>
			<button
				type="button"
				class="site-header__menu-toggle"
				id="site-nav-toggle"
				aria-controls="primary-nav"
				aria-expanded="false"
				aria-label="Abrir menú"
			>
				<span class="site-header__menu-toggle-bar" aria-hidden="true"></span>
				<span class="site-header__menu-toggle-bar" aria-hidden="true"></span>
				<span class="site-header__menu-toggle-bar" aria-hidden="true"></span>
			</button>
			<nav class="site-header__nav" id="primary-nav" aria-label="Secciones">
				<a href="#confianza" class="site-header__link" data-i18n="navTrust">Confianza</a>
				<a href="#bolsos" class="site-header__link" data-i18n="navBags">Bolsos</a>
				<a href="#proceso" class="site-header__link" data-i18n="navProcess">Proceso</a>
				<a href="#resenas" class="site-header__link" data-i18n="navReviews">Reseñas</a>
				<a href="#faq" class="site-header__link" data-i18n="navFaq">FAQ</a>
				<a href="#about" class="site-header__link" data-i18n="navArtist">Artista</a>
				<a
					class="site-header__link site-header__link--quiet"
					href="https://victoria-citro-hoo0-staging.b12sites.com/index"
					target="_blank"
					rel="noreferrer"
					data-i18n="navMurales">Murales</a>
				<a href="/kit-mundial" class="site-header__kit" data-i18n="navKit">Kit Mundial 🇦🇷</a>
				<a href="/ebooks" class="site-header__ebook" data-i18n="navEbook">Guía duelo</a>
				<div class="site-header__nav-actions">
					<button id="lang-toggle" class="site-header__lang" type="button" aria-label="Cambiar idioma">EN</button>
					<a
						class="site-header__icon"
						href="https://www.instagram.com/victoria.citro/"
						target="_blank"
						rel="noreferrer"
						aria-label="Instagram"
					>
						<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6"
							><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r="1.2" fill="currentColor" stroke="none"
						/></svg>
					</a>
					<a
						class="site-header__icon"
						href="https://www.tiktok.com/@vIKICITROART"
						target="_blank"
						rel="noreferrer"
						aria-label="TikTok"
					>
						<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"
							><path
								d="M17.5 6.5v9.2a4.3 4.3 0 01-4.1 4.3 4.3 4.3 0 01-3.4-1.7 4.2 4.2 0 01-.8-2.5h2.6c0 .6.5 1.1 1.1 1.1s1.1-.5 1.1-1.1V9.2h-2.1V6.5h2.1V4h2.6v2.5h2.1z"
						/></svg>
					</a>
				</div>
			</nav>
		</div>
	</header>

	<div class="hero-band" id="inicio">
		<img src="/images/Portada_Bag_.jpg" alt="Victoria Citro con bolso pintado" loading="eager" />
		<div class="hero-overlay">
			<div class="hero-content">
				<div class="hero-copy">
					<h1 class="brand-title" aria-label="Victoria Citro">
						<span class="brand-title__mid brand-title__mid--edge" aria-hidden="true">·</span><span class="brand-title__word">VICTORIA</span><span class="brand-title__word">CITRO</span><span class="brand-title__mid brand-title__mid--edge" aria-hidden="true">·</span>
					</h1>
					<p class="tagline" data-i18n="tagline">BOLSOS DE LUJO PINTADOS A MANO · MURALES Y ARTE</p>
					<p class="hero-promise" data-i18n="heroPromise">
						Tu mascota u objeto fiel, retratado a mano sobre cuero de lujo. Consultá plazos y presupuesto sin compromiso.
					</p>
				</div>
				<div class="hero-cta-shell">
					<div class="cta-row cta-row--hero-stack hero-cta-outside">
						<button type="button" class="btn btn-primary btn-cta-lg js-open-order-dialog" data-i18n="ctaOrder">
							PIDE TU BOLSO PERSONALIZADO
						</button>
					</div>
				</div>
				<a href="#confianza" class="hero-scroll-hint">
					<span class="hero-scroll-hint__text" data-i18n="scrollHint">Seguir leyendo</span>
					<span class="hero-scroll-hint__chev" aria-hidden="true"></span>
				</a>
				<div class="awards-fog">
					<p class="awards" data-i18n="awardsTitle">EXHIBIDA Y PREMIADA EN:</p>
					<div class="awards-marquee" aria-live="polite">
						<div class="awards-marquee__track">
							<span class="awards-marquee__text cities" data-i18n="awardsList">
								WORLD ART DUBAI, NFT PARIS, VENICE BIENALE, SCOPE MIAMI, CAIRO NEMEC, FORBES MAGAZINE,
								PORTOFINNO CASTELLO BROWN, MUSEUM OF THE FUTURE DUBAI, NOX TOKYO.
							</span>
							<span class="awards-marquee__text cities" data-i18n="awardsList" aria-hidden="true">
								WORLD ART DUBAI, NFT PARIS, VENICE BIENALE, SCOPE MIAMI, CAIRO NEMEC, FORBES MAGAZINE,
								PORTOFINNO CASTELLO BROWN, MUSEUM OF THE FUTURE DUBAI, NOX TOKYO.
							</span>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>

	<main class="page-main">
		<section class="conv-trust" id="confianza" aria-label="Información de confianza">
			<div class="conv-shell">
				<ul class="conv-trust__list">
					<li class="conv-trust__item">
						<span class="conv-trust__icon" aria-hidden="true">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"
								><path d="M12 3l2 4 4.5.5-3.5 3 1 4.5L12 14l-4 3 1-4.5L5.5 7.5 10 7l2-4z"
							/></svg>
						</span>
						<span data-i18n="trust1">Pintura manual artesanal: cada pieza es única.</span>
					</li>
					<li class="conv-trust__item">
						<span class="conv-trust__icon" aria-hidden="true">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"
								><path d="M4 8h16v10H4zM8 8V6a4 4 0 018 0v2" stroke-linejoin="round"
							/></svg>
						</span>
						<span data-i18n="trust2">Envíos coordinados a medida según destino.</span>
					</li>
					<li class="conv-trust__item">
						<span class="conv-trust__icon" aria-hidden="true">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"
								><path d="M21 11.5V19a2 2 0 01-2 2H5a2 2 0 01-2-2v-7.5M3 7l9-4 9 4M8 21v-6h8v6" stroke-linejoin="round"
							/></svg>
						</span>
						<span data-i18n="trust3">Respuesta por WhatsApp en horario hábil.</span>
					</li>
				</ul>
			</div>
		</section>

		<section class="middle-band" id="bolsos">
			<img src="/images/bags.png" alt="Modelos de bolsos personalizados" loading="lazy" />
			<div class="middle-overlay">
				<div class="middle-overlay__panel">
					<h2 data-i18n="middleTitle">BOLSOS DE LUJO PERSONALIZADOS</h2>
					<p data-i18n="middleSubtitle">PINTADOS A MANO · UNICOS · HECHOS CON AMOR</p>
					<button type="button" class="btn btn-middle-cta js-open-order-dialog" data-i18n="middleCta">Pedir aquí</button>
				</div>
			</div>
		</section>

		<section class="conv-steps" id="proceso" aria-labelledby="conv-steps-title">
			<div class="conv-shell">
				<h2 class="conv-steps__title" id="conv-steps-title" data-i18n="stepsTitle">Cómo encargar tu bolso</h2>
				<ol class="conv-steps__grid">
					<li class="conv-steps__card">
						<span class="conv-steps__num" aria-hidden="true">1</span>
						<h3 class="conv-steps__card-title" data-i18n="step1Title">Escribinos</h3>
						<p class="conv-steps__card-text" data-i18n="step1Text">
							Contanos la idea, referencias fotográficas y el bolso o superficie que te gustaría.
						</p>
					</li>
					<li class="conv-steps__card">
						<span class="conv-steps__num" aria-hidden="true">2</span>
						<h3 class="conv-steps__card-title" data-i18n="step2Title">Propuesta y plazo</h3>
						<p class="conv-steps__card-text" data-i18n="step2Text">
							Victoria prepara una propuesta creativa, tiempos de trabajo e inversión clara.
						</p>
					</li>
					<li class="conv-steps__card">
						<span class="conv-steps__num" aria-hidden="true">3</span>
						<h3 class="conv-steps__card-title" data-i18n="step3Title">Pintura y entrega</h3>
						<p class="conv-steps__card-text" data-i18n="step3Text">
							Ejecución a mano, revisión final y envío cuidado hasta tu puerta.
						</p>
					</li>
				</ol>
				<div class="conv-steps__cta">
					<button type="button" class="btn btn-primary btn-cta-lg js-open-order-dialog" data-i18n="stepsCta">Pedir bolso</button>
				</div>
			</div>
		</section>

		<section class="conv-spotlight" aria-labelledby="conv-spotlight-title">
			<div class="conv-shell">
				<h2 class="conv-spotlight__eyebrow" id="conv-spotlight-title" data-i18n="spotlightEyebrow">
					Lo que dicen quienes ya encargaron
				</h2>
				<blockquote class="conv-spotlight__quote">
					<p data-i18n="spotlightQuote">
						El detalle del retrato de mi perro superó todo lo que imaginé. Es una pieza de galería que llevo todos
						los días.
					</p>
					<footer><cite data-i18n="spotlightBy">— Clienta, Buenos Aires</cite></footer>
				</blockquote>
			</div>
		</section>

		<section class="reviews-strip" id="resenas">
			<div class="reviews-inner">
				<p class="reviews-title" data-i18n="reviewsTitle">RESEÑAS - TESTIMONIOS DE CLIENTES</p>
				<div class="reviews-grid">
					<article class="review-card">
						<img src="/images/woman_dog_bag_1.jpeg" alt="Review cliente 1" loading="lazy" />
						<p>★★★★★</p>
						<span data-i18n="review1">"EL MEJOR REGALO..."</span>
					</article>
					<article class="review-card">
						<img src="/images/bag_woman_2.jpeg" alt="Review cliente 2" loading="lazy" />
						<p>★★★★★</p>
						<span data-i18n="review2">"CALIDAD DE LUJO..."</span>
					</article>
					<article class="review-card">
						<img src="/images/bag_woman_3.jpeg" alt="Review cliente 3" loading="lazy" />
						<p>★★★★★</p>
						<span data-i18n="review3">"...HERMOSO"</span>
					</article>
				</div>
			</div>
		</section>

		<section class="kit-promo" id="kit-mundial" aria-labelledby="kit-promo-title">
			<div class="conv-shell kit-promo__inner">
				<figure class="kit-promo__media">
					<img
						src="/images/kit-mundial-ejemplo-teddy.png"
						alt="Ejemplo de Kit Mundial personalizado con la mascota Teddy: remera, taza, tote, gorra y cuadro estilo hincha de Argentina"
						loading="lazy"
						width="1024"
						height="819"
					/>
				</figure>
				<div class="kit-promo__copy">
					<p class="kit-promo__eyebrow" data-i18n="kitEyebrow">Nuevo · Edición Hincha 🇦🇷</p>
					<h2 class="kit-promo__title" id="kit-promo-title" data-i18n="kitTitle">
						Tu mascota, versión hincha de Argentina
					</h2>
					<p class="kit-promo__text" data-i18n="kitText">
						Subí su foto y mirá al instante una vista previa con IA de tu Kit Mundial: remera, taza,
						tote, cuadro y gorra con tu mascota ilustrada. Gratis, sin compromiso y con envío a todo
						el país.
					</p>
					<div class="kit-promo__cta">
						<a class="btn btn-primary btn-cta-lg" href="/kit-mundial" data-i18n="kitCta">Ver mi Kit gratis</a>
					</div>
				</div>
			</div>
		</section>

		<section class="conv-faq" id="faq" aria-labelledby="conv-faq-title">
			<div class="conv-shell">
				<h2 class="conv-faq__title" id="conv-faq-title" data-i18n="faqTitle">Preguntas frecuentes</h2>
				<div class="conv-faq__list">
					<details class="conv-faq__item">
						<summary data-i18n="faq1q">¿Cuánto tarda un encargo?</summary>
						<p data-i18n="faq1a">
							Los plazos dependen de la complejidad y la agenda. En el primer contacto te damos un rango
							realista.
						</p>
					</details>
					<details class="conv-faq__item">
						<summary data-i18n="faq2q">¿Pueden pintar cualquier mascota u objeto?</summary>
						<p data-i18n="faq2a">
							Sí, trabajamos con referencias claras. Cuanto mejor sea la foto, más fiel puede ser el
							resultado.
						</p>
					</details>
					<details class="conv-faq__item">
						<summary data-i18n="faq3q">¿Cómo pago y recibo el bolso?</summary>
						<p data-i18n="faq3a">
							Coordinamos medios de pago y envío antes de iniciar. También puede haber retiro según
							ubicación.
						</p>
					</details>
				</div>
			</div>
		</section>

		<section class="conv-teaser" aria-labelledby="conv-teaser-title">
			<div class="conv-shell">
				<div class="conv-teaser__panel">
					<p class="conv-teaser__label" id="conv-teaser-title" data-i18n="teaserEyebrow">Próximamente</p>
					<p class="conv-teaser__text" data-i18n="teaserText">
						Láminas y piezas bajo demanda con preview por chat: ver la idea antes de bordarla en cuero. Dejanos tu
						interés al pedir un bolso.
					</p>
					<div class="conv-teaser__cta">
						<button type="button" class="btn btn-primary btn-cta-lg js-open-order-dialog" data-i18n="teaserCta">Pedir bolso</button>
					</div>
				</div>
			</div>
		</section>

		<section class="about-band" id="about">
			<img src="/images/Portada_Bag_2.jpg" alt="Victoria Citro con mascota" loading="lazy" />
			<div class="about-overlay">
				<div class="about-card">
					<p class="about-title" data-i18n="aboutTitle">SOBRE LA ARTISTA</p>
					<h2>VICTORIA CITRO</h2>
					<p class="about-card__hint" data-i18n="aboutReadHint">Historia en cuatro pasos — bajá con calma.</p>
					<p data-i18n="aboutP1">
						Victoria es una artista contemporánea argentina cuyo trabajo combina creatividad,
						narrativa emocional y un profundo amor por los animales. Tras vivir y crear en
						Mallorca, España, y expandir su visión internacionalmente, ha exhibido su arte en
						ciudades como Dubái, Venecia, Londres, Nueva York, Portofino y Miami.
					</p>
					<p data-i18n="aboutP2">
						Su pasión por los animales no es solo inspiración: es parte de su vida. Victoria
						rescata y cuida activamente animales de la calle, y ese vínculo profundo está en
						el corazón de su marca. Cada bolso pintado a mano se crea con intención, emoción
						y amor.
					</p>
					<p data-i18n="aboutP3">
						Combinando artesanía de lujo con una historia personal, Victoria transforma cada
						pieza en un tesoro emocional único. Su obra es vibrante, expresiva y llena de
						alma, como los animales que honra a través de su arte.
					</p>
					<p data-i18n="aboutP4">
						Esto no es solo una marca.
						<br />Es amor. Es memoria. Es arte hecho desde el corazón.
					</p>
				</div>
			</div>
		</section>

		<section class="conv-close" id="pedido" aria-labelledby="conv-close-title">
			<div class="conv-shell conv-close__panel">
				<h2 class="conv-close__title" id="conv-close-title" data-i18n="closeTitle">Tu pieza única, a un mensaje</h2>
				<ul class="conv-close__list">
					<li data-i18n="closeLi1">Diseño personalizado pintado a mano sobre cuero de lujo.</li>
					<li data-i18n="closeLi2">Comunicación directa con la artista.</li>
					<li data-i18n="closeLi3">Ideal para regalo y herencia emocional.</li>
				</ul>
				<div class="conv-close__cta">
					<button type="button" class="btn btn-primary btn-cta-lg js-open-order-dialog" data-i18n="closeCta1">Pedir mi bolso</button>
					<a class="btn btn-secondary btn-cta-lg" href="/ebooks" data-i18n="closeCta2">Guía sobre duelo de mascotas</a>
				</div>
			</div>
		</section>
	</main>

	<OrderDialog />
	<VcAutoscroll />

	<script is:inline>
		const langToggle = document.querySelector('#lang-toggle');
		const siteHeader = document.querySelector('.site-header');
		const navToggle = document.querySelector('#site-nav-toggle');
		const primaryNav = document.getElementById('primary-nav');

		const navMenuAria = (lang, open) =>
			lang === 'en' ? (open ? 'Close menu' : 'Open menu') : open ? 'Cerrar menú' : 'Abrir menú';

		const setNavOpen = (open) => {
			if (!siteHeader || !navToggle) return;
			if (open) siteHeader.classList.add('is-nav-open');
			else siteHeader.classList.remove('is-nav-open');
			const lang = document.documentElement.lang === 'en' ? 'en' : 'es';
			navToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
			navToggle.setAttribute('aria-label', navMenuAria(lang, open));
			document.body.classList.toggle('is-nav-drawer-open', open);
		};

		navToggle?.addEventListener('click', () => {
			const open = !siteHeader?.classList.contains('is-nav-open');
			setNavOpen(open);
		});

		primaryNav?.querySelectorAll('a').forEach((a) => {
			a.addEventListener('click', () => setNavOpen(false));
		});

		document.addEventListener('keydown', (e) => {
			if (e.key === 'Escape') setNavOpen(false);
		});

		document.addEventListener('click', (e) => {
			if (!siteHeader?.classList.contains('is-nav-open')) return;
			const t = e.target;
			if (t instanceof Node && !siteHeader.contains(t)) setNavOpen(false);
		});

		document.querySelector('.site-header__brand')?.addEventListener('click', () => setNavOpen(false));

		window.addEventListener('resize', () => {
			if (window.matchMedia('(min-width: 769px)').matches) setNavOpen(false);
		});

		if (!window.__cvInPageScrollInit) {
			window.__cvInPageScrollInit = true;

			function __cvClickTargetEl(ev) {
				let n = ev.target;
				if (!n) return null;
				if (n.nodeType === 3 && n.parentElement) n = n.parentElement;
				return n instanceof Element ? n : null;
			}

			function __cvFindHashAnchor(ev) {
				const path = typeof ev.composedPath === 'function' ? ev.composedPath() : null;
				if (path && path.length) {
					for (let i = 0; i < path.length; i++) {
						const n = path[i];
						if (n instanceof HTMLAnchorElement) {
							const h = n.getAttribute('href');
							if (h && h !== '#' && h.startsWith('#')) return n;
						}
					}
				}
				const el = __cvClickTargetEl(ev);
				return el && el.closest ? el.closest('a[href^="#"]') : null;
			}

			function __cvHeaderScrollPad() {
				const root = document.documentElement;
				const spt = parseFloat(getComputedStyle(root).scrollPaddingTop);
				if (Number.isFinite(spt) && spt > 0) return spt;
				const h = document.querySelector('.site-header');
				return h ? h.offsetHeight : 0;
			}

			function __cvYForElement(el) {
				const rect = el.getBoundingClientRect();
				const pad = __cvHeaderScrollPad();
				const sy = window.scrollY || document.documentElement.scrollTop || document.body.scrollTop || 0;
				return Math.max(0, Math.round(rect.top + sy - pad));
			}

			function __cvReducedMotion() {
				return window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
			}

			function __cvSetScrollY(y) {
				y = Math.max(0, Math.round(y));
				if (!Number.isFinite(y)) return;
				window.scrollTo(0, y);
				document.documentElement.scrollTop = y;
				document.body.scrollTop = y;
			}

			function __cvScrollToY(targetY, instant) {
				const startY = window.scrollY || document.documentElement.scrollTop || document.body.scrollTop || 0;
				const dist = targetY - startY;
				if (Math.abs(dist) < 2) {
					__cvSetScrollY(targetY);
					return;
				}
				if (instant) {
					__cvSetScrollY(targetY);
					return;
				}
				const duration = Math.min(950, 380 + Math.abs(dist) * 0.42);
				const t0 = performance.now();
				function ease(t) {
					return 1 - Math.pow(1 - t, 3);
				}
				function tick(now) {
					const u = Math.min(1, (now - t0) / duration);
					__cvSetScrollY(startY + dist * ease(u));
					if (u < 1) requestAnimationFrame(tick);
				}
				requestAnimationFrame(tick);
			}

			function __cvInPageScrollHandler(e) {
				if (e.defaultPrevented) return;
				if (e.button !== 0) return;
				if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
				const a = __cvFindHashAnchor(e);
				if (!a || !(a instanceof HTMLAnchorElement)) return;
				if (a.target === '_blank' || a.hasAttribute('download')) return;
				const href = a.getAttribute('href');
				if (!href || href === '#') return;
				const id = decodeURIComponent(href.slice(1).split('?')[0]);
				if (!id) return;
				const target = document.getElementById(id);
				if (!target) return;
				e.preventDefault();
				requestAnimationFrame(() => {
					const y = __cvYForElement(target);
					__cvScrollToY(y, __cvReducedMotion());
				});
