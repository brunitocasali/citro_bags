---
// Página de retorno post-pago. Lee ?order=... y consulta el estado hasta confirmarlo.
import MetaPixel from '../components/MetaPixel.astro';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>¡Gracias por tu compra! · Victoria Citro</title>
    <MetaPixel />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,400..700;1,400..700&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/ebooks/css/ebooks-landing.css" />
    <link rel="icon" href="/ebook/favicon-vc.png" type="image/png" />
  </head>
  <body>
    <div class="vc-page">
      <header class="vc-header">
        <div class="vc-header__inner">
          <a class="vc-brand" href="/ebooks">
            <span class="vc-brand__name">Victoria Citro</span>
            <span class="vc-brand__tag">Arte &amp; duelo</span>
          </a>
        </div>
      </header>

      <section class="vc-download" style="min-height:70vh">
        <div class="vc-shell">
          <div class="vc-download__box">
            <h2 id="vc-title">Confirmando tu pago…</h2>
            <p class="vc-download__hint" id="vc-hint">Esto puede tardar unos segundos. No cierres esta página.</p>
            <div id="vc-downloads" style="margin-top:1.5rem;display:flex;flex-direction:column;gap:.75rem"></div>
            <p class="vc-form__note" id="vc-help" style="margin-top:1.5rem"></p>
          </div>
        </div>
      </section>
    </div>

    <script>
      const apiBase =
        location.hostname === 'localhost' || location.hostname === '127.0.0.1'
          ? 'http://localhost:4000'
          : '';
      const orderId = new URLSearchParams(location.search).get('order');
      const title = document.getElementById('vc-title');
      const hint = document.getElementById('vc-hint');
      const downloads = document.getElementById('vc-downloads');
      const help = document.getElementById('vc-help');

      if (!orderId) {
        title.textContent = 'Orden no encontrada';
        hint.textContent = 'No pudimos identificar tu compra.';
      } else {
        let tries = 0;
        const maxTries = 40; // ~2 min
        let purchaseFired = false;

        async function check() {
          tries++;
          try {
            const res = await fetch(apiBase + '/api/order/' + orderId);
            const data = await res.json();

            if (data.status === 'approved') {
              // Meta Purchase (navegador) — SOLO con pago aprobado. Mismo event_id que
              // Conversions API (backend) para que Meta deduplique.
              if (!purchaseFired && data.event_id && window.vcMeta) {
                purchaseFired = true;
                window.vcMeta.track(
                  'Purchase',
                  {
                    value: data.value,
                    currency: data.currency || 'ARS',
                    content_ids: data.content_ids || [],
                    content_type: 'product',
                  },
                  data.event_id
                );
              }

              title.textContent = '¡Gracias por tu compra! 💛';
              downloads.innerHTML = '';
              const hasDownloads = (data.downloads || []).length > 0;
              if (hasDownloads) {
                hint.textContent = 'Tu acceso está listo. Descargá tu material:';
                data.downloads.forEach((d) => {
                  const a = document.createElement('a');
                  a.href = d.url;
                  a.className = 'vc-btn vc-btn--solid';
                  a.textContent = '⬇ ' + d.title;
                  downloads.appendChild(a);
                });
                help.textContent = 'También te enviamos el acceso a ' + (data.email || 'tu email') + '.';
              } else {
                // Producto físico: no hay descarga, coordinamos el envío.
                hint.textContent = 'Recibimos tu pago. En breve nos comunicamos para coordinar los detalles y el envío.';
                help.textContent = 'Te enviamos la confirmación a ' + (data.email || 'tu email') + '.';
              }
              // Cupón 10% OFF en productos personalizados (si lo sumaron al carrito).
              const hasCoupon = (data.items || []).some((i) => i.slug === 'cupon-personalizados');
              if (hasCoupon) {
                const box = document.createElement('div');
                box.style.cssText =
                  'margin-top:1.25rem;padding:1rem 1.25rem;border:1px dashed #a68b67;border-radius:14px;background:#fffef9;text-align:center';
                box.innerHTML =
                  '<p style="margin:0 0 .35rem;font-weight:700;color:#4a3728">🎁 Tu 10% OFF en productos personalizados</p>' +
                  '<p style="margin:0;color:#6b5e54;font-size:.92rem;line-height:1.5">Usá el código <b style="font-size:1.15rem;letter-spacing:.05em;color:#4a3728">VICTORIA10</b> al encargar tu retrato o producto personalizado con Victoria.</p>';
                downloads.appendChild(box);
              }
              // Retrato digital de mascota: si lo compró, mostramos la herramienta para subir la foto.
              const hasPortrait = (data.items || []).some((i) => i.slug === 'retrato-mascota');
              if (hasPortrait) renderPortraitTool();
              return;
            }
            if (data.status === 'rejected') {
              title.textContent = 'El pago no se completó';
              hint.textContent = 'No se aprobó el pago. Podés intentar de nuevo.';
              downloads.innerHTML = '<a class="vc-btn vc-btn--solid" href="/comprar">Volver a intentar</a>';
              return;
            }
          } catch {
            /* reintenta */
          }
          if (tries < maxTries) {
            setTimeout(check, 3000);
          } else {
            title.textContent = 'Seguimos procesando tu pago';
            hint.textContent =
              'Si ya pagaste, tu acceso puede tardar unos minutos. Te lo enviaremos por email en cuanto se confirme.';
          }
        }

        // Herramienta para generar el retrato digital (solo si la orden lo incluye y está pagada).
        function renderPortraitTool() {
          if (document.getElementById('vc-pet-tool')) return; // no duplicar entre reintentos
          const box = document.createElement('div');
          box.id = 'vc-pet-tool';
          box.style.cssText =
            'margin-top:1.5rem;padding:1.25rem;border:1px solid #e6dcc9;border-radius:16px;background:#fffef9;text-align:left';
          box.innerHTML =
            '<p style="margin:0 0 .35rem;font-weight:700;color:#4a3728;font-size:1.05rem">🎨 Creá el retrato digital de tu mascota</p>' +
            '<p style="margin:0 0 .9rem;color:#6b5e54;font-size:.9rem;line-height:1.5">Subí una foto clara de tu mascota (de frente, buena luz, sin accesorios si se puede). En un ratito generamos tu pintura artística.</p>' +
            '<input id="vc-pet-file" type="file" accept="image/*" style="width:100%;margin-bottom:.75rem" />' +
            '<button id="vc-pet-btn" class="vc-btn vc-btn--solid" type="button" style="width:100%">Generar mi retrato</button>' +
            '<p id="vc-pet-msg" style="margin:.75rem 0 0;font-size:.85rem;color:#6b5e54;text-align:center"></p>' +
            '<div id="vc-pet-result" style="margin-top:1rem;display:flex;flex-direction:column;gap:.75rem"></div>';
          downloads.appendChild(box);

          const fileEl = box.querySelector('#vc-pet-file');
          const btn = box.querySelector('#vc-pet-btn');
          const msg = box.querySelector('#vc-pet-msg');
          const result = box.querySelector('#vc-pet-result');

          btn.addEventListener('click', async () => {
            const f = fileEl.files && fileEl.files[0];
            if (!f) {
              msg.textContent = 'Elegí una foto primero.';
              return;
            }
            btn.disabled = true;
            msg.textContent = 'Generando tu retrato… puede tardar hasta 1 minuto. No cierres la página.';
            result.innerHTML = '';
            try {
              const fd = new FormData();
              fd.append('order', orderId);
              fd.append('foto', f);
              const res = await fetch(apiBase + '/api/pet-portrait', { method: 'POST', body: fd });
              const data = await res.json();
              if (!res.ok || !data.image) throw new Error(data.error || 'No se pudo generar el retrato.');
              const img = document.createElement('img');
              img.src = data.image;
              img.alt = 'Retrato artístico de tu mascota';
              img.style.cssText = 'width:100%;border-radius:12px;box-shadow:0 12px 32px rgba(61,52,45,.18)';
              const dl = document.createElement('a');
              dl.href = data.image;
              dl.download = 'retrato-mascota.png';
              dl.className = 'vc-btn vc-btn--solid';
              dl.textContent = '⬇ Descargar mi retrato';
              result.appendChild(img);
              result.appendChild(dl);
              const rem = typeof data.remaining === 'number' ? data.remaining : 0;
              msg.textContent = rem > 0 ? '¿No te convenció? Podés generar ' + rem + ' más.' : '';
              btn.disabled = rem === 0;
              if (rem === 0) btn.style.display = 'none';
            } catch (e) {
              msg.textContent = e.message || 'No se pudo generar el retrato. Probá de nuevo.';
              btn.disabled = false;
            }
          });
        }

        check();
      }
    </script>
  </body>
</html>
