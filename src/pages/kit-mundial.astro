---
import Layout from '../layouts/Layout.astro';
import '../styles/kit-mundial.css';
---

<Layout
	title="Kit Mundial · CITRO Arte | Tu mascota, versión hincha de Argentina"
	description="Subí la foto de tu mascota y mirá cómo quedaría ilustrada estilo hincha de Argentina, antes de comprar. Remera, taza, tote, cuadro y gorra personalizados. Envíos a todo el país."
>
	<div class="km">
		<!-- ============================ top bar ============================ -->
		<header class="km-top">
			<div class="km-top__inner">
				<a class="km-top__brand" href="#top">CITRO Arte</a>
				<a
					class="km-top__wa"
					href="https://wa.me/5493517417645"
					target="_blank"
					rel="noreferrer"
				>
					<svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"
						><path d="M12 2a10 10 0 00-8.7 15l-1.3 4.8 4.9-1.3A10 10 0 1012 2zm5.8 14.2c-.2.7-1.4 1.3-2 1.4-.5.1-1.2.1-1.9-.1-.4-.1-1-.3-1.7-.6-3-1.3-5-4.4-5.1-4.6-.2-.2-1.3-1.7-1.3-3.2s.8-2.3 1.1-2.6c.3-.3.6-.4.8-.4h.6c.2 0 .4 0 .7.5l.9 2.1c.1.2.1.4 0 .6l-.4.6c-.2.2-.3.4-.1.7.2.3.9 1.4 1.9 2.3 1.3 1.1 2.3 1.5 2.6 1.6.3.1.5.1.7-.1l.9-1.1c.2-.3.5-.2.7-.1l2 1c.3.1.5.2.5.4.1.2.1.9-.1 1.5z"
					/></svg>
					WhatsApp
				</a>
			</div>
		</header>

		<span id="top" class="km-sr"></span>

		<!-- ============================ hero ============================ -->
		<section class="km-hero">
			<div class="km-hero__glow" aria-hidden="true"></div>
			<div class="km__shell km-hero__inner">
				<div class="km-hero__copy">
					<span class="km__eyebrow">Kit Mundial · Edición Hincha 🇦🇷</span>
					<h1 class="km-hero__title">
						Mirá a tu mascota hecha <em>arte</em>, antes de comprar.
					</h1>
					<p class="km-hero__lead">
						Subí su foto y su nombre. Victoria la convierte en una ilustración estilo hincha de
						Argentina sobre remera, taza, tote, cuadro y gorra — y te la mostramos antes de imprimir.
					</p>
					<div class="km-hero__cta-row">
						<a class="km-btn km-btn--primary km-btn--lg" href="#crear">Quiero mi diseño gratis</a>
						<a class="km-btn km-btn--ghost km-btn--lg" href="#kits">Ver kits y precios</a>
					</div>
					<p class="km-hero__reassure">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"
							><path d="M20 6L9 17l-5-5" stroke-linecap="round" stroke-linejoin="round" /></svg>
						Sin cargo y sin compromiso · Envíos a todo el país
					</p>
				</div>

				<div class="km-hero__visual">
					<div class="km-card-float km-card-float--main">
						<div class="km-hero__scene">
							<img
								src="/images/kit-mundial-ejemplo-teddy.png"
								alt="Ejemplo de Kit Mundial personalizado con la mascota Teddy: remera, taza, tote, gorra y cuadro estilo hincha de Argentina"
								loading="eager"
								width="1024"
								height="819"
							/>
						</div>
					</div>
					<div class="km-card-float km-card-float--badge">
						<strong>+500</strong>
						<span>mascotas ya convertidas en arte 🐾</span>
					</div>
				</div>
			</div>
		</section>

		<!-- ============================ cómo funciona ============================ -->
		<section class="km-section km-section--tinted" id="como-funciona">
			<div class="km__shell">
				<div class="km-section__head">
					<span class="km__eyebrow">Cómo funciona</span>
					<h2 class="km-section__title">De la foto al arte, en 4 pasos</h2>
				</div>
				<ol class="km-steps">
					<li class="km-step">
						<span class="km-step__n">1</span>
						<h3 class="km-step__title">Mandás la foto</h3>
						<p class="km-step__text">Subís la foto de tu mascota y su nombre. Una o hasta 5 mascotas.</p>
					</li>
					<li class="km-step">
						<span class="km-step__n">2</span>
						<h3 class="km-step__title">Victoria la ilustra</h3>
						<p class="km-step__text">La convierte en una ilustración única, cuidando sus rasgos reales.</p>
					</li>
					<li class="km-step">
						<span class="km-step__n">3</span>
						<h3 class="km-step__title">La ves antes de comprar</h3>
						<p class="km-step__text">Te mostramos el diseño para que lo apruebes con confianza.</p>
					</li>
					<li class="km-step">
						<span class="km-step__n">4</span>
						<h3 class="km-step__title">La recibís</h3>
						<p class="km-step__text">Elegís tu kit y te llega listo, con envío gratis a todo el país.</p>
					</li>
				</ol>
			</div>
		</section>

		<!-- ============================ wizard ============================ -->
		<section class="km-section" id="crear">
			<div class="km__shell">
				<div class="km-section__head">
					<span class="km__eyebrow">Diseño gratis</span>
					<h2 class="km-section__title">Creá el diseño de tu mascota</h2>
					<p class="km-section__sub">Te lleva menos de un minuto. Te mostramos cómo queda antes de que decidas.</p>
				</div>

				<div class="km-wizard-wrap">
					<div class="km-wizard" id="km-wizard">
						<div class="km-wizard__bar" aria-hidden="true">
							<span data-bar="0"></span>
							<span data-bar="1"></span>
						</div>

						<form id="km-form" class="km-wizard__body" novalidate>
							<!-- step 0: cantidad -->
							<div class="km-step-panel is-active" data-step="0">
								<p class="km-wizard__stepcount">Paso 1 de 2</p>
								<h3 class="km-wizard__q">¿Es una mascota o varias?</h3>
								<p class="km-wizard__hint">Nos ayuda a preparar mejor tu diseño.</p>
								<div class="km-choices" role="radiogroup" aria-label="Cantidad de mascotas">
									<label class="km-choice">
										<input type="radio" name="cantidad" value="una" />
										<span class="km-choice__emoji" aria-hidden="true">🐶</span>
										<span class="km-choice__label">Una</span>
										<span class="km-choice__sub">Un perro o gato</span>
									</label>
									<label class="km-choice">
										<input type="radio" name="cantidad" value="varias" />
										<span class="km-choice__emoji" aria-hidden="true">🐶🐱</span>
										<span class="km-choice__label">Varias</span>
										<span class="km-choice__sub">Hasta 5 mascotas</span>
									</label>
								</div>
								<p class="km-error" data-error="0" role="alert"></p>
							</div>

							<!-- step 1: foto + nombres -->
							<div class="km-step-panel" data-step="1">
								<p class="km-wizard__stepcount">Paso 2 de 2</p>
								<h3 class="km-wizard__q" id="km-name-q">Subí la foto y el nombre</h3>
								<p class="km-wizard__hint" id="km-name-hint">Con eso te mostramos al toque cómo quedaría tu mascota ilustrada.</p>

								<div class="km-drop" id="km-drop" tabindex="0" role="button" aria-label="Subir foto de tu mascota">
									<div class="km-drop__icon" aria-hidden="true">
										<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"
											><path d="M12 16V4m0 0L8 8m4-4l4 4" stroke-linecap="round" stroke-linejoin="round"/><path d="M4 16v2a2 2 0 002 2h12a2 2 0 002-2v-2" stroke-linecap="round"/></svg>
									</div>
									<p class="km-drop__title" id="km-drop-title">Tocá para subir la foto de tu mascota</p>
									<p class="km-drop__hint">JPG, PNG o HEIC (iPhone) · de frente, con buena luz</p>
									<input id="km-files" type="file" accept="image/*,.heic,.heif,image/heic,image/heif" multiple hidden />
								</div>
								<div class="km-thumbs" id="km-thumbs"></div>

								<div class="km-field" style="margin-top:1rem;">
									<label for="km-nombre-mascota" id="km-name-label">Nombre de la mascota</label>
									<input class="km-input" id="km-nombre-mascota" name="nombre_mascota" type="text" autocomplete="off" placeholder="Ej: Coco" />
								</div>
								<div class="km-field">
									<label for="km-nombre">Tu nombre <span class="km-optional">(opcional)</span></label>
									<input class="km-input" id="km-nombre" name="nombre_cliente" type="text" autocomplete="name" placeholder="Tu nombre" />
								</div>

								<div class="km-photo-tip">
									<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"
										><circle cx="12" cy="12" r="9"/><path d="M12 8h.01M11 12h1v4h1" stroke-linecap="round" stroke-linejoin="round"/></svg>
									<span id="km-photo-collage">Una foto nítida y de frente hace toda la diferencia. Evitá fotos borrosas o muy lejanas.</span>
								</div>
								<p class="km-error" data-error="1" role="alert"></p>
							</div>

							<!-- nav -->
							<div class="km-wizard__nav">
								<button type="button" class="km-btn km-btn--ghost" id="km-back" hidden>Atrás</button>
								<button type="button" class="km-btn km-btn--primary" id="km-next">Siguiente</button>
								<button type="submit" class="km-btn km-btn--primary" id="km-submit" hidden>Ver cómo queda 🎨</button>
							</div>
						</form>

						<!-- loading -->
						<div class="km-loading" id="km-loading" role="status" aria-live="polite">
							<div class="km-loading__spin" aria-hidden="true"></div>
							<h3 class="km-loading__title">Preparando tu vista previa…</h3>
							<p class="km-loading__text">
								Estoy bocetando a <span id="km-loading-name">tu mascota</span>. Puede tardar hasta un
								minuto — no cierres esta pantalla. 🎨
							</p>
						</div>

						<!-- result (vista previa / boceto generado) -->
						<div class="km-result" id="km-result" role="status" aria-live="polite">
							<h3 class="km-result__title">Te dejo una vista previa de tu Kit 💛</h3>
							<div class="km-result__frame">
								<img id="km-result-img" alt="Boceto ilustrativo de tu mascota en el Kit Mundial" />
							</div>
							<div class="km-result__disclaimer">
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"
									><circle cx="12" cy="12" r="9"/><path d="M12 8h.01M11 12h1v4h1" stroke-linecap="round" stroke-linejoin="round"/></svg>
								<span><strong>Es un boceto para que veas la idea 🎨</strong> La ilustración final la termino a mano yo, cuidando cada detalle de <span id="km-result-name">tu mascota</span>. Es ilustrativo, <strong>no necesariamente la imagen definitiva</strong>. En el kit, cada producto (remera, taza, tote, cuadro y gorra) lleva su propia adaptación del diseño — no va la misma imagen calcada en todos.</span>
							</div>
							<p class="km-result__cta-hint">
								¿Te gustó? <strong>Guardá la imagen</strong> y mandámela por WhatsApp para pedir tu kit. 💛
							</p>
							<div class="km-result__actions">
								<a class="km-btn km-btn--ghost" id="km-download" download="mi-kit-mundial.png" href="#">Guardar imagen</a>
								<button type="button" class="km-btn km-btn--primary" id="km-result-wa">
									<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"
										><path d="M12 2a10 10 0 00-8.7 15l-1.3 4.8 4.9-1.3A10 10 0 1012 2zm5.8 14.2c-.2.7-1.4 1.3-2 1.4-.5.1-1.2.1-1.9-.1-.4-.1-1-.3-1.7-.6-3-1.3-5-4.4-5.1-4.6-.2-.2-1.3-1.7-1.3-3.2s.8-2.3 1.1-2.6c.3-.3.6-.4.8-.4h.6c.2 0 .4 0 .7.5l.9 2.1c.1.2.1.4 0 .6l-.4.6c-.2.2-.3.4-.1.7.2.3.9 1.4 1.9 2.3 1.3 1.1 2.3 1.5 2.6 1.6.3.1.5.1.7-.1l.9-1.1c.2-.3.5-.2.7-.1l2 1c.3.1.5.2.5.4.1.2.1.9-.1 1.5z"/></svg>
									Pedir mi kit por WhatsApp
								</button>
							</div>
							<button type="button" class="km-result__retry" id="km-retry">Probar con otra foto</button>
							<p class="km-result__tip-save" id="km-save-tip">En el celular: mantené presionada la imagen para guardarla en tu galería.</p>
						</div>

						<!-- success (fallback WhatsApp, si la generación no está disponible) -->
						<div class="km-success" id="km-success" role="status" aria-live="polite">
							<div class="km-success__mark" aria-hidden="true">
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
									><path d="M20 6L9 17l-5-5" stroke-linecap="round" stroke-linejoin="round"/></svg>
							</div>
							<h3 class="km-success__title">¡Te abrimos WhatsApp! 🐾</h3>
							<p class="km-success__text">
								Enviános ahí la foto de <span id="km-success-name">tu mascota</span> y listo.
								Victoria la va a ilustrar a mano con dedicación y en las próximas horas te manda el
								diseño para que lo veas antes de decidir. 💛
							</p>
							<div class="km-success__note">
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"
									><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2" stroke-linecap="round" stroke-linejoin="round"/></svg>
								<span>¿No se abrió WhatsApp? <a href="https://wa.me/5493517417645" target="_blank" rel="noreferrer" style="color:inherit;font-weight:600;">Tocá acá para escribirnos.</a></span>
							</div>
						</div>

						<!-- error (no se pudo generar el boceto) -->
						<div class="km-errbox" id="km-errbox" role="alert" aria-live="assertive">
							<div class="km-errbox__mark" aria-hidden="true">
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
									><circle cx="12" cy="12" r="9"/><path d="M12 8v5M12 16.5h.01" stroke-linecap="round" stroke-linejoin="round"/></svg>
							</div>
							<h3 class="km-errbox__title">Uy, ahora no pudimos generar tu vista previa 😔</h3>
							<p class="km-errbox__text" id="km-errbox-text">
								Puede ser algo temporal. Si es una foto de iPhone, probá en Ajustes → Cámara → Formatos →
								"Más compatible", o mandanos la foto de
								<span id="km-errbox-name">tu mascota</span> directo por WhatsApp y Victoria te prepara el diseño a mano. 💛
							</p>
							<div class="km-errbox__actions">
								<button type="button" class="km-btn km-btn--ghost" id="km-errbox-retry">Reintentar</button>
								<button type="button" class="km-btn km-btn--primary" id="km-errbox-wa">
									<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"
										><path d="M12 2a10 10 0 00-8.7 15l-1.3 4.8 4.9-1.3A10 10 0 1012 2zm5.8 14.2c-.2.7-1.4 1.3-2 1.4-.5.1-1.2.1-1.9-.1-.4-.1-1-.3-1.7-.6-3-1.3-5-4.4-5.1-4.6-.2-.2-1.3-1.7-1.3-3.2s.8-2.3 1.1-2.6c.3-.3.6-.4.8-.4h.6c.2 0 .4 0 .7.5l.9 2.1c.1.2.1.4 0 .6l-.4.6c-.2.2-.3.4-.1.7.2.3.9 1.4 1.9 2.3 1.3 1.1 2.3 1.5 2.6 1.6.3.1.5.1.7-.1l.9-1.1c.2-.3.5-.2.7-.1l2 1c.3.1.5.2.5.4.1.2.1.9-.1 1.5z"/></svg>
									Enviar mi foto por WhatsApp
								</button>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- ============================ kits ============================ -->
		<section class="km-section km-section--tinted" id="kits">
			<div class="km__shell">
				<div class="km-section__head">
					<span class="km__eyebrow">Kits más elegidos</span>
					<h2 class="km-section__title">Elegí cómo llevar a tu mascota</h2>
					<p class="km-section__sub">Mismo precio sin importar cuántas mascotas incluya el diseño (hasta 5). Todos los kits con envío gratis.</p>
				</div>
				<figure class="km-example">
					<img
						src="/images/kit-mundial-ejemplo-teddy.png"
						alt="Ejemplo de Kit Mundial real: la mascota Teddy ilustrada en remera, taza, tote, gorra y cuadro"
						loading="lazy"
						width="1024"
						height="819"
					/>
					<figcaption>Ejemplo real: el Kit de Teddy 🐾🇦🇷 Cada producto lleva su propia adaptación del diseño.</figcaption>
				</figure>
				<div class="km-kits">
					<article class="km-kit">
						<span class="km-kit__tag">Clásico</span>
						<h3 class="km-kit__name">Kit Hincha Clásico</h3>
						<p class="km-kit__desc">Remera + taza personalizada con tu mascota.</p>
						<p class="km-kit__price">$75.000 <small>Envío gratis</small></p>
					</article>
					<article class="km-kit km-kit--featured">
						<span class="km-kit__tag">El más elegido</span>
						<h3 class="km-kit__name">Kit Recuerdo Mundialero</h3>
						<p class="km-kit__desc">Remera + taza + cuadrito para guardar el recuerdo para siempre.</p>
						<p class="km-kit__price">$145.000 <small>Envío gratis</small></p>
					</article>
					<article class="km-kit">
						<span class="km-kit__tag">Full</span>
						<h3 class="km-kit__name">Kit Full Mundial</h3>
						<p class="km-kit__desc">Remera + taza + tote + gorra + cuadrito. El más completo.</p>
						<p class="km-kit__price">$169.000 <small>Envío gratis</small></p>
					</article>
				</div>
				<p class="km-note-center">
					¿Preferís un producto suelto? Taza $24.000 · Remera $56.000 · Tote $36.000 · Cuadro $45.000 · Gorra $39.000
				</p>
				<div style="text-align:center; margin-top:1.6rem;">
					<a class="km-btn km-btn--primary km-btn--lg" href="#crear">Empezar por mi diseño gratis</a>
				</div>
			</div>
		</section>

		<!-- ============================ faq ============================ -->
		<section class="km-section" id="faq">
			<div class="km__shell">
				<div class="km-section__head">
					<span class="km__eyebrow">Preguntas frecuentes</span>
					<h2 class="km-section__title">Lo que más nos consultan</h2>
				</div>
				<div class="km-faq">
					<details class="km-faq__item">
						<summary>¿Cuánto tarda el diseño?</summary>
						<p>Cada diseño se ilustra y revisa a mano, uno por uno. En las próximas horas del día te lo enviamos para que lo veas antes de comprar.</p>
					</details>
					<details class="km-faq__item">
						<summary>¿De qué zona son? ¿Hacen envíos?</summary>
						<p>Operamos desde Argentina y hacemos envíos a todo el país. Los kits incluyen envío gratis a sucursal de Correo Argentino.</p>
					</details>
					<details class="km-faq__item">
						<summary>¿El precio cambia si son varias mascotas?</summary>
						<p>No. El precio del kit es el mismo tenga 1 o hasta 5 mascotas en el diseño.</p>
					</details>
					<details class="km-faq__item">
						<summary>¿Puedo ver el diseño antes de pagar?</summary>
						<p>¡Sí! Ese es el sentido: primero te mostramos cómo queda tu mascota ilustrada y después decidís tranquila/o.</p>
					</details>
					<details class="km-faq__item">
						<summary>¿Qué talles de remera tienen?</summary>
						<p>Contamos con talles del S al XXL. Si necesitás un talle especial, escribinos por WhatsApp y lo vemos.</p>
					</details>
				</div>
			</div>
		</section>

		<footer class="km-footer">
			<div class="km__shell">
				<p>CITRO Arte · Productos personalizados con la foto de tu mascota 🐾</p>
				<p style="margin-top:.4rem;">
					<a href="https://www.instagram.com/victoria.citro/" target="_blank" rel="noreferrer">Instagram</a>
					·
					<a href="https://wa.me/5493517417645" target="_blank" rel="noreferrer">WhatsApp</a>
				</p>
			</div>
		</footer>
	</div>

	<script is:inline>
		(function () {
			// ================== CONFIG ==================
			var WHATSAPP_NUMBER = '5493517417645'; // número de contacto
			// Base del backend (mismo criterio que /comprar): en dev, el server local; en prod, mismo dominio.
			var API_BASE =
				location.hostname === 'localhost' || location.hostname === '127.0.0.1'
					? 'http://localhost:4000'
					: '';
			var MAX_FILES = 5;
			var MAX_SIZE_MB = 20;
			var FETCH_TIMEOUT_MS = 180000; // 3 min — alineado con nginx proxy_read_timeout y OpenAI
			// ============================================

			var form = document.getElementById('km-form');
			if (!form) return;

			var panels = Array.prototype.slice.call(form.querySelectorAll('.km-step-panel'));
			var bars = Array.prototype.slice.call(document.querySelectorAll('.km-wizard__bar span'));
			var backBtn = document.getElementById('km-back');
			var nextBtn = document.getElementById('km-next');
			var submitBtn = document.getElementById('km-submit');
			var dropZone = document.getElementById('km-drop');
			var dropTitle = document.getElementById('km-drop-title');
			var fileInput = document.getElementById('km-files');
			var thumbs = document.getElementById('km-thumbs');
			var loadingEl = document.getElementById('km-loading');
			var loadingName = document.getElementById('km-loading-name');
			var resultEl = document.getElementById('km-result');
			var resultImg = document.getElementById('km-result-img');
			var downloadLink = document.getElementById('km-download');
			var resultWaBtn = document.getElementById('km-result-wa');
			var retryBtn = document.getElementById('km-retry');
			var successEl = document.getElementById('km-success');
			var successName = document.getElementById('km-success-name');
			var errboxEl = document.getElementById('km-errbox');
			var errboxName = document.getElementById('km-errbox-name');
			var errboxText = document.getElementById('km-errbox-text');
			var errboxRetry = document.getElementById('km-errbox-retry');
			var errboxWa = document.getElementById('km-errbox-wa');
			var photoCollage = document.getElementById('km-photo-collage');
			var nameHint = document.getElementById('km-name-hint');

			var state = { step: 0, files: [], sending: false };
			var LAST = 1;

			function val(sel) {
				var el = form.querySelector(sel);
				return el ? el.value.trim() : '';
			}

			function isVarias() {
				var el = form.querySelector('input[name="cantidad"]:checked');
				return el && el.value === 'varias';
			}

			function setError(step, msg) {
				var el = form.querySelector('[data-error="' + step + '"]');
				if (el) el.textContent = msg || '';
			}

			function clearErrors() {
				for (var i = 0; i <= LAST; i++) setError(i, '');
			}

			function render() {
				panels.forEach(function (p) {
					p.classList.toggle('is-active', Number(p.getAttribute('data-step')) === state.step);
				});
				bars.forEach(function (b, i) {
					b.classList.toggle('is-done', i <= state.step);
				});
				backBtn.hidden = state.step === 0;
				var last = state.step === LAST;
				nextBtn.hidden = last;
				submitBtn.hidden = !last;

				// adaptar copy según cantidad
				var varias = isVarias();
				var nameQ = document.getElementById('km-name-q');
				if (nameQ) nameQ.textContent = varias ? 'Subí las fotos y los nombres' : 'Subí la foto y el nombre';
				if (dropTitle) {
					dropTitle.textContent = varias
						? 'Tocá para subir una foto por cada mascota'
						: 'Tocá para subir la foto de tu mascota';
				}
				var nameLabel = document.getElementById('km-name-label');
				if (nameLabel) nameLabel.textContent = varias ? 'Nombres de las mascotas' : 'Nombre de la mascota';
				var petInput = document.getElementById('km-nombre-mascota');
				if (petInput) petInput.placeholder = varias ? 'Ej: Coco, Luna y Toby' : 'Ej: Coco';
				if (photoCollage) {
					photoCollage.textContent = varias
						? 'Subí una foto por cada mascota (no un collage), de frente y con buena luz.'
						: 'Una foto nítida y de frente hace toda la diferencia. Evitá fotos borrosas o muy lejanas.';
				}

				var active = panels[state.step];
				var focusable = active && active.querySelector('input:not([type=file]), [tabindex]');
				if (focusable) focusable.focus({ preventScroll: true });
			}

			// ---------------- files ----------------
			function humanSize(bytes) { return (bytes / (1024 * 1024)).toFixed(1) + ' MB'; }

			function isIosSafari() {
				var ua = navigator.userAgent || '';
				return /iPhone|iPad|iPod/i.test(ua) || (/Safari/i.test(ua) && /Apple/i.test(navigator.vendor || ''));
			}

			function isJpegFile(f) {
				var mime = (f.type || '').toLowerCase();
				var name = (f.name || '').toLowerCase();
				return mime === 'image/jpeg' || mime === 'image/jpg' || /\.jpe?g$/i.test(name);
			}

			function isHeicLike(f) {
				var mime = (f.type || '').toLowerCase();
				var name = (f.name || '').toLowerCase();
				return /\.(heic|heif)$/i.test(name) || mime.indexOf('heic') >= 0 || mime.indexOf('heif') >= 0;
			}

			/**
			 * En iPhone/Safari: re-codificamos TODA foto vía canvas → JPEG liviano.
			 * Si falla, rechazamos (no mandamos HEIC crudo al server — falla en ~10s).
			 */
			function convertPhotoForUpload(file) {
				return new Promise(function (resolve, reject) {
					if (!isIosSafari()) { resolve(file); return; }
					var url = URL.createObjectURL(file);
					var img = new Image();
					var settled = false;
					var loadTimer = setTimeout(function () {
						if (settled) return;
						settled = true;
						URL.revokeObjectURL(url);
						reject(new Error('timeout'));
					}, 30000);
					function done(err, result) {
						if (settled) return;
						settled = true;
						clearTimeout(loadTimer);
						URL.revokeObjectURL(url);
						if (err) reject(err);
						else resolve(result);
					}
					img.onload = function () {
						try {
							var w = img.naturalWidth || img.width;
							var h = img.naturalHeight || img.height;
							if (!w || !h) { done(new Error('no-dimensions')); return; }
							var maxDim = 2048;
							if (Math.max(w, h) > maxDim) {
								var scale = maxDim / Math.max(w, h);
								w = Math.round(w * scale);
								h = Math.round(h * scale);
							}
							var c = document.createElement('canvas');
							c.width = w;
							c.height = h;
							c.getContext('2d').drawImage(img, 0, 0, w, h);
							c.toBlob(function (blob) {
								if (!blob) { done(new Error('no-blob')); return; }
								var base = (file.name || 'foto').replace(/\.[^.]+$/i, '') || 'foto';
								done(null, new File([blob], base + '.jpg', { type: 'image/jpeg', lastModified: Date.now() }));
							}, 'image/jpeg', 0.88);
						} catch (e) {
							done(e);
						}
					};
					img.onerror = function () { done(new Error('img-error')); };
					img.src = url;
				});
			}

			function iosPhotoNotReadyMsg() {
				return 'No pudimos preparar la foto en tu iPhone. Probá Ajustes → Cámara → Formatos → "Más compatible", o mandanos la foto por WhatsApp.';
			}

			function ensureIosJpegFiles(files) {
				if (!isIosSafari()) return null;
				for (var i = 0; i < files.length; i++) {
					if (!isJpegFile(files[i]) || isHeicLike(files[i])) return iosPhotoNotReadyMsg();
				}
				return null;
			}

			function fetchWithTimeout(url, options, ms) {
				var controller = new AbortController();
				var timer = setTimeout(function () { controller.abort(); }, ms);
				return fetch(url, Object.assign({}, options || {}, { signal: controller.signal }))
					.finally(function () { clearTimeout(timer); });
			}

			function errorMessageForResponse(status, data) {
				if (data && data.error) return data.error;
				if (status === 413) return 'La foto es muy pesada para el servidor. Probá con WiFi o mandala por WhatsApp.';
				if (status === 502 || status === 504) return 'El servidor tardó demasiado. Probá de nuevo con WiFi (puede tardar hasta 2 minutos).';
				if (status === 0) return 'No pudimos conectar. Revisá tu señal o probá con WiFi.';
				return null;
			}

			function addFiles(list) {
				setError(1, '');
				var incoming = Array.prototype.slice.call(list || []);
				var valid = [];
				for (var i = 0; i < incoming.length; i++) {
					var f = incoming[i];
					var mime = (f.type || '').toLowerCase();
					var isImageType = /^image\//.test(mime);
					var isHeicName = /\.(heic|heif)$/i.test(f.name || '');
					var isPhotoName = /\.(jpe?g|png|webp|gif|heic|heif)$/i.test(f.name || '');
					var isOctet = !mime || mime === 'application/octet-stream' || mime === 'binary/octet-stream';
					var isLikelyPhoto = isImageType || isHeicName || isPhotoName || (isOctet && f.size > 8000);
					if (!isLikelyPhoto) {
						setError(1, 'Ese archivo no es una imagen. Subí una foto (JPG, PNG o HEIC de iPhone).');
						continue;
					}
					if (f.size > MAX_SIZE_MB * 1024 * 1024) { setError(1, 'La foto pesa más de ' + MAX_SIZE_MB + ' MB (' + humanSize(f.size) + '). Probá con una más liviana.'); continue; }
					if (state.files.length + valid.length >= MAX_FILES) { setError(1, 'Máximo ' + MAX_FILES + ' fotos.'); break; }
					valid.push(f);
				}
				if (!valid.length) return;

				// iPhone: convertir a JPEG apenas se elige la foto (no esperar al submit).
				Promise.all(valid.map(convertPhotoForUpload))
					.then(function (prepared) {
						for (var j = 0; j < prepared.length; j++) {
							if (state.files.length >= MAX_FILES) break;
							state.files.push(prepared[j]);
						}
						renderThumbs();
					})
					.catch(function () {
						setError(1, iosPhotoNotReadyMsg());
					});
			}

			function renderThumbs() {
				thumbs.innerHTML = '';
				state.files.forEach(function (f, idx) {
					var url = URL.createObjectURL(f);
					var wrap = document.createElement('div');
					wrap.className = 'km-thumb';
					var img = document.createElement('img');
					img.src = url;
					img.alt = 'Foto ' + (idx + 1);
					// Los HEIC no se previsualizan fuera de Safari: mostramos un cartelito en vez del ícono roto.
					img.addEventListener('error', function () {
						wrap.classList.add('km-thumb--nopreview');
						img.remove();
					});
					var del = document.createElement('button');
					del.type = 'button';
					del.className = 'km-thumb__del';
					del.setAttribute('aria-label', 'Quitar foto ' + (idx + 1));
					del.textContent = '×';
					del.addEventListener('click', function () {
						URL.revokeObjectURL(url);
						state.files.splice(idx, 1);
						renderThumbs();
					});
					wrap.appendChild(img);
					wrap.appendChild(del);
					thumbs.appendChild(wrap);
				});
			}

			dropZone.addEventListener('click', function () { fileInput.click(); });
			dropZone.addEventListener('keydown', function (e) {
				if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); fileInput.click(); }
			});
			fileInput.addEventListener('change', function () { addFiles(fileInput.files); fileInput.value = ''; });
			['dragenter', 'dragover'].forEach(function (ev) {
				dropZone.addEventListener(ev, function (e) { e.preventDefault(); dropZone.classList.add('is-dragover'); });
			});
			['dragleave', 'drop'].forEach(function (ev) {
				dropZone.addEventListener(ev, function (e) { e.preventDefault(); dropZone.classList.remove('is-dragover'); });
			});
			dropZone.addEventListener('drop', function (e) {
				if (e.dataTransfer && e.dataTransfer.files) addFiles(e.dataTransfer.files);
			});

			// ---------------- validation ----------------
			function validateStep(step) {
				if (step === 0 && !form.querySelector('input[name="cantidad"]:checked')) {
					setError(0, 'Elegí una opción para seguir.');
					return false;
				}
				if (step === 1) {
					if (state.files.length === 0) { setError(1, 'Subí al menos una foto de tu mascota.'); return false; }
					if (!val('#km-nombre-mascota')) { setError(1, isVarias() ? 'Contanos los nombres de tus mascotas.' : 'Contanos el nombre de tu mascota.'); return false; }
				}
				setError(step, '');
				return true;
			}

			nextBtn.addEventListener('click', function () {
				if (!validateStep(state.step)) return;
				if (state.step < LAST) { state.step++; render(); }
			});
			backBtn.addEventListener('click', function () {
				if (state.step > 0) { state.step--; render(); }
			});

			// ---------------- WhatsApp ----------------
			function openWhatsApp(withDesign) {
				var yo = val('#km-nombre');
				var mascota = val('#km-nombre-mascota') || 'mi mascota';
				// Emojis como escapes unicode ASCII: así sobreviven a cualquier problema de
				// charset al servir la página (si quedaran como literales y el host sirviera
				// el HTML como no-UTF-8, los emojis del plano astral llegan rotos a WhatsApp).
				var PAW = String.fromCodePoint(0x1f43e); // 🐾
				var FLAG_AR = String.fromCodePoint(0x1f1e6, 0x1f1f7); // 🇦🇷
				var CLIP = String.fromCodePoint(0x1f4ce); // 📎
				var lines = [
					(yo ? '¡Hola! Soy ' + yo + '. ' : '¡Hola! ') + 'Quiero el Kit Mundial ' + PAW + FLAG_AR,
					(isVarias() ? 'Mis mascotas: ' : 'Mi mascota: ') + mascota,
					'',
					withDesign
						? 'Te adjunto el diseño que generé en la web ' + CLIP
						: 'Te adjunto la foto de mi mascota ' + CLIP,
				];
				var url = 'https://wa.me/' + WHATSAPP_NUMBER + '?text=' + encodeURIComponent(lines.join('\n'));
				window.open(url, '_blank');
			}

			// ---------------- panels ----------------
			function hideAll() {
				form.style.display = 'none';
				loadingEl.classList.remove('is-active');
				resultEl.classList.remove('is-active');
				successEl.classList.remove('is-active');
				if (errboxEl) errboxEl.classList.remove('is-active');
			}

			function showLoading() {
				if (loadingName) loadingName.textContent = val('#km-nombre-mascota') || 'tu mascota';
				hideAll();
				loadingEl.classList.add('is-active');
				loadingEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
			}

			function showResult(dataUrl) {
				hideAll();
				resultImg.src = dataUrl;
				var resultName = document.getElementById('km-result-name');
				if (resultName) resultName.textContent = val('#km-nombre-mascota') || 'tu mascota';
				var slug = (val('#km-nombre-mascota') || 'mi-mascota').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '') || 'mi-mascota';
				downloadLink.href = dataUrl;
				downloadLink.setAttribute('download', 'kit-mundial-' + slug + '.png');
				resultEl.classList.add('is-active');
				resultEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
			}

			function showSuccess() {
				if (successName) successName.textContent = val('#km-nombre-mascota') || 'tu mascota';
				hideAll();
				successEl.classList.add('is-active');
				successEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
			}

			// Muestra un mensaje de error CLARO en pantalla (no redirige en silencio).
			function showError(serverMsg) {
				if (errboxName) errboxName.textContent = val('#km-nombre-mascota') || 'tu mascota';
				if (errboxText && serverMsg) errboxText.textContent = serverMsg;
				hideAll();
				if (errboxEl) {
					errboxEl.classList.add('is-active');
					errboxEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
				}
			}

			// Vuelve al formulario (paso 2) manteniendo la foto ya subida.
			function backToForm() {
				hideAll();
				form.style.display = '';
				state.step = LAST;
				render();
			}

			resultWaBtn.addEventListener('click', function () { openWhatsApp(true); });

			retryBtn.addEventListener('click', function () {
				state.files = [];
				renderThumbs();
				resultEl.classList.remove('is-active');
				form.style.display = '';
				state.step = 1;
				render();
			});

			if (errboxRetry) errboxRetry.addEventListener('click', backToForm);
			if (errboxWa) errboxWa.addEventListener('click', function () { openWhatsApp(false); });

			// ---------------- submit → generar preview ----------------
			form.addEventListener('submit', function (e) {
				e.preventDefault();
				if (state.sending) return;
				if (!validateStep(LAST)) return;

				state.sending = true;
				submitBtn.disabled = true;
				showLoading();

				// iPhone: verificar JPEG antes de subir (evita fallo rápido ~10s por HEIC en el server).
				Promise.all(state.files.map(convertPhotoForUpload))
					.then(function (preparedFiles) {
						var iosBlock = ensureIosJpegFiles(preparedFiles);
						if (iosBlock) {
							showError(iosBlock);
							throw new Error('ios-not-jpeg');
						}
						var fd = new FormData();
						fd.append('cantidad_mascotas', isVarias() ? 'varias' : 'una');
						fd.append('nombre_mascota', val('#km-nombre-mascota'));
						fd.append('nombre_cliente', val('#km-nombre'));
						preparedFiles.forEach(function (f, idx) {
							var name = f.name || ('foto-' + (idx + 1) + '.jpg');
							if (!/\.jpe?g$/i.test(name)) name = name.replace(/\.[^.]+$/, '') + '.jpg';
							fd.append('foto', f, name);
						});
						return fetchWithTimeout(API_BASE + '/api/kit-preview', { method: 'POST', body: fd }, FETCH_TIMEOUT_MS);
					})
					.then(function (r) {
						if (!r || !r.json) return { ok: false, status: 0, data: {} };
						return r.json().catch(function () { return {}; }).then(function (data) {
							return { ok: r.ok, status: r.status, data: data || {} };
						});
					})
					.then(function (res) {
						if (res.ok && res.data && res.data.image) {
							showResult(res.data.image);
						} else if (res.status === 503) {
							showSuccess();
						} else if (res.status) {
							showError(errorMessageForResponse(res.status, res.data));
						}
					})
					.catch(function (err) {
						if (err && err.message === 'ios-not-jpeg') return;
						if (err && err.message === 'timeout') {
							showError(iosPhotoNotReadyMsg());
						} else if (err && err.name === 'AbortError') {
							showError('La generación tardó más de 3 minutos. Probá con WiFi o mandanos la foto por WhatsApp.');
						} else if (err && (err.message === 'img-error' || err.message === 'no-blob' || err.message === 'no-dimensions')) {
							showError(iosPhotoNotReadyMsg());
						} else if (err) {
							showError('No pudimos conectar con el servidor. Si estás en 4G, probá con WiFi o mandanos la foto por WhatsApp.');
						}
					})
					.finally(function () {
						state.sending = false;
						submitBtn.disabled = false;
					});
			});

			form.querySelectorAll('input[name="cantidad"]').forEach(function (r) {
				r.addEventListener('change', function () { setError(0, ''); });
			});

			clearErrors();
			render();
		})();
	</script>
</Layout>
