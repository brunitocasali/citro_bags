---
import { META_PIXEL_ID_EBOOKS, type PixelViewContent } from '../../config/metaPixelEbooks';

interface Props {
	/** Si viene definido (ficha de un ebook), se envía además `ViewContent`. */
	viewContent?: PixelViewContent;
}

const { viewContent } = Astro.props;
const pixelId = META_PIXEL_ID_EBOOKS;
const hasVc = Boolean(viewContent?.id);
const vcId = viewContent?.id ?? '';
const vcName = viewContent?.name ?? '';
const noscriptSrc = `https://www.facebook.com/tr?id=${pixelId}&ev=PageView&noscript=1`;
---

<!-- Meta Pixel — solo ebooks -->
<script is:inline define:vars={{ pixelId, hasVc, vcId, vcName }}>
	!(function (f, b, e, v, n, t, s) {
		if (f.fbq) return;
		n = f.fbq = function () {
			n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments);
		};
		if (!f._fbq) f._fbq = n;
		n.push = n;
		n.loaded = !0;
		n.version = '2.0';
		n.queue = [];
		t = b.createElement(e);
		t.async = !0;
		t.src = v;
		s = b.getElementsByTagName(e)[0];
		s.parentNode.insertBefore(t, s);
	})(window, document, 'script', 'https://connect.facebook.net/en_US/fbevents.js');
	fbq('init', pixelId);
	fbq('track', 'PageView');
	if (hasVc && vcId) {
		fbq('track', 'ViewContent', {
			content_ids: [vcId],
			content_name: vcName || vcId,
			content_type: 'product',
		});
	}
</script>
<noscript>
	<img height="1" width="1" style="display: none" src={noscriptSrc} alt="" />
</noscript>
