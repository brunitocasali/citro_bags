---
/* Recorrido automático al cargar: home y /ebooks. Textos ES/EN autónomos (CV_SITE_LANG / CV_EB_LANG). */
---

<div id="vc-autoscroll" class="vc-autoscroll" role="region" aria-labelledby="vc-autoscroll-title">
	<p id="vc-autoscroll-title" class="vc-autoscroll__title"></p>
	<button type="button" id="vc-autoscroll-toggle" class="vc-autoscroll__toggle" aria-pressed="true"></button>
	<div id="vc-autoscroll-volume" class="vc-autoscroll__volume" role="group" aria-labelledby="vc-autoscroll-speed-legend">
		<span id="vc-autoscroll-speed-legend" class="vc-autoscroll__sr-only"></span>
		<button type="button" id="vc-autoscroll-slower" class="vc-autoscroll__step" aria-label="">−</button>
		<input
			type="range"
			id="vc-autoscroll-speed"
			class="vc-autoscroll__range"
			min="25"
			max="380"
			step="5"
			value="85"
			aria-valuemin="25"
			aria-valuemax="380"
		/>
		<button type="button" id="vc-autoscroll-faster" class="vc-autoscroll__step" aria-label="">+</button>
	</div>
	<p id="vc-autoscroll-hint" class="vc-autoscroll__hint"></p>
</div>

<script is:inline>
	(function initVcAutoscroll() {
		if (document.documentElement.dataset.vcAutoscrollBooted) return;
		document.documentElement.dataset.vcAutoscrollBooted = '1';

		try {
			const st = localStorage.getItem('site-lang') === 'en' ? 'en' : 'es';
			document.documentElement.lang = st;
		} catch (_) {}

		const COPY = {
			es: {
				title: 'Recorrido automático',
				pause: 'Pausar',
				resume: 'Reanudar',
				hint: 'Tocá o deslizá la página para frenar el recorrido.',
				slower: 'Más lento',
				faster: 'Más rápido',
				speedGroup: 'Velocidad del recorrido',
			},
			en: {
				title: 'Guided scroll',
				pause: 'Pause',
				resume: 'Resume',
				hint: 'Tap or scroll the page to stop.',
				slower: 'Slower',
				faster: 'Faster',
				speedGroup: 'Scroll speed',
			},
		};

		const root = document.getElementById('vc-autoscroll');
		const titleEl = document.getElementById('vc-autoscroll-title');
		const hintEl = document.getElementById('vc-autoscroll-hint');
		const legendEl = document.getElementById('vc-autoscroll-speed-legend');
		const toggle = document.getElementById('vc-autoscroll-toggle');
		const slider = document.getElementById('vc-autoscroll-speed');
		const slower = document.getElementById('vc-autoscroll-slower');
		const faster = document.getElementById('vc-autoscroll-faster');
		if (!root || !titleEl || !hintEl || !legendEl || !toggle || !slider || !slower || !faster) return;

		const reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		if (reduce) {
			root.hidden = true;
			return;
		}

		function lang() {
			return document.documentElement.lang === 'en' ? 'en' : 'es';
		}

		function t() {
			return COPY[lang()] || COPY.es;
		}

		function refreshCopy() {
			const c = t();
			titleEl.textContent = c.title;
			hintEl.textContent = c.hint;
			legendEl.textContent = c.speedGroup;
			slower.setAttribute('aria-label', c.slower);
			faster.setAttribute('aria-label', c.faster);
			syncToggle();
		}

		let autoRunning = false;
		let rafId = 0;
		let lastTs = 0;
		let speed = parseInt(slider.value, 10) || 85;

		/** En móvil el alto útil suele ser 0 al primer frame; sin esto nunca arranca (0 >= maxY-2). */
		const MIN_SCROLL_RANGE = 12;
		let savedHtmlScrollBehavior = '';
		let savedBodyScrollBehavior = '';
		let instantScrollLock = 0;

		function scrollEl() {
			return document.scrollingElement || document.documentElement;
		}

		function viewH() {
			const vv = window.visualViewport;
			return vv && vv.height > 0 ? vv.height : window.innerHeight;
		}

		function maxY() {
			const h = Math.max(
				document.documentElement.scrollHeight || 0,
				document.body ? document.body.scrollHeight || 0 : 0,
				scrollEl().scrollHeight || 0
			);
			return Math.max(0, h - viewH());
		}

		function currentY() {
			const se = scrollEl();
			return window.scrollY ?? window.pageYOffset ?? se.scrollTop ?? 0;
		}

		function setScrollY(y) {
			const my = maxY();
			y = Math.max(0, Math.min(my, Math.round(y)));
			const se = scrollEl();
			se.scrollTop = y;
			try {
				window.scrollTo({ left: 0, top: y, behavior: 'instant' });
			} catch (_) {
				window.scrollTo(0, y);
			}
			if (document.body && document.body !== se) document.body.scrollTop = y;
		}

		function applyInstantScrollCss() {
			if (instantScrollLock === 0) {
				savedHtmlScrollBehavior = document.documentElement.style.scrollBehavior;
				savedBodyScrollBehavior = document.body ? document.body.style.scrollBehavior : '';
			}
			instantScrollLock++;
			document.documentElement.style.scrollBehavior = 'auto';
			if (document.body) document.body.style.scrollBehavior = 'auto';
		}

		function restoreScrollBehaviorCss() {
			if (instantScrollLock > 0) instantScrollLock--;
			if (instantScrollLock !== 0) return;
			document.documentElement.style.scrollBehavior = savedHtmlScrollBehavior;
			if (document.body) document.body.style.scrollBehavior = savedBodyScrollBehavior;
		}

		function syncToggle() {
			const c = t();
			toggle.textContent = autoRunning ? c.pause : c.resume;
			toggle.setAttribute('aria-pressed', autoRunning ? 'true' : 'false');
		}

		function stopAuto() {
			autoRunning = false;
			lastTs = 0;
			if (rafId) cancelAnimationFrame(rafId);
			rafId = 0;
			restoreScrollBehaviorCss();
			syncToggle();
		}

		function tick(ts) {
			if (!autoRunning) return;
			if (!lastTs) {
				lastTs = ts;
				rafId = requestAnimationFrame(tick);
				return;
			}
			const dt = Math.min(80, ts - lastTs) / 1000;
			lastTs = ts;
			const my = maxY();
			const y0 = currentY();
			if (my < MIN_SCROLL_RANGE) {
				rafId = requestAnimationFrame(tick);
				return;
			}
			if (y0 >= my - 1.5) {
				stopAuto();
				return;
			}
			setScrollY(y0 + speed * dt);
			rafId = requestAnimationFrame(tick);
		}

		function startAuto() {
			if (reduce) return;
			const my = maxY();
			if (my < MIN_SCROLL_RANGE) return;
			if (currentY() >= my - 2) return;
			autoRunning = true;
			applyInstantScrollCss();
			lastTs = 0;
			if (rafId) cancelAnimationFrame(rafId);
			syncToggle();
			rafId = requestAnimationFrame(tick);
		}

		function onToggleTap(e) {
			e.preventDefault();
			e.stopPropagation();
			if (autoRunning) stopAuto();
			else startAuto();
		}

		toggle.addEventListener('click', onToggleTap);

		function bump(delta) {
			const mn = parseInt(slider.getAttribute('min'), 10) || 25;
			const mx = parseInt(slider.getAttribute('max'), 10) || 380;
			speed = Math.min(mx, Math.max(mn, speed + delta));
			slider.value = String(speed);
			try {
				localStorage.setItem('vc-autoscroll-speed', String(speed));
			} catch (_) {}
		}

		function stopEv(e) {
			e.stopPropagation();
		}

		slider.addEventListener('click', stopEv);
		slider.addEventListener('input', () => {
			speed = parseInt(slider.value, 10) || 85;
			try {
				localStorage.setItem('vc-autoscroll-speed', String(speed));
			} catch (_) {}
		});

		function onStep(e) {
			e.preventDefault();
			e.stopPropagation();
		}

		slower.addEventListener('click', (e) => {
			onStep(e);
			bump(-25);
		});
		faster.addEventListener('click', (e) => {
			onStep(e);
			bump(25);
		});

		function userInterrupt(e) {
			if (!autoRunning) return;
			const raw = e.target;
			if (!raw) return;
			const node = raw.nodeType === 3 && raw.parentElement ? raw.parentElement : raw;
			if (!(node instanceof Element)) return;
			if (root.contains(node)) return;
			if (node.closest && node.closest('dialog[open]')) {
				stopAuto();
				return;
			}
			if (node.tagName === 'INPUT' || node.tagName === 'TEXTAREA' || node.tagName === 'SELECT' || node.isContentEditable)
				return;
			stopAuto();
		}

		['wheel', 'touchstart', 'touchmove', 'mousedown', 'pointerdown', 'keydown'].forEach((ev) => {
			window.addEventListener(ev, userInterrupt, { capture: true, passive: true });
		});

		const orderDlg = document.querySelector('#order-dialog');
		orderDlg?.addEventListener('toggle', () => {
			if (orderDlg.open) stopAuto();
		});

		window.visualViewport?.addEventListener('resize', () => {
			if (autoRunning && currentY() > maxY() + 2) setScrollY(maxY());
		});

		try {
			const saved = localStorage.getItem('vc-autoscroll-speed');
			if (saved) {
				const v = parseInt(saved, 10);
				const mn = parseInt(slider.getAttribute('min'), 10);
				const mx = parseInt(slider.getAttribute('max'), 10);
				if (Number.isFinite(v) && v >= mn && v <= mx) {
					speed = v;
					slider.value = String(v);
				}
			}
		} catch (_) {}

		function onLang() {
			refreshCopy();
		}
		window.addEventListener('CV_SITE_LANG', onLang);
		window.addEventListener('CV_EB_LANG', onLang);

		refreshCopy();

		let bootFrames = 0;
		const BOOT_MAX_FRAMES = 180;
		function tryBootAutoscroll() {
			if (reduce) return;
			if (autoRunning) return;
			bootFrames++;
			const my = maxY();
			if (my >= MIN_SCROLL_RANGE && currentY() < my - 2) {
				startAuto();
				return;
			}
			if (bootFrames < BOOT_MAX_FRAMES) requestAnimationFrame(tryBootAutoscroll);
		}

		requestAnimationFrame(() => {
			requestAnimationFrame(tryBootAutoscroll);
		});

		window.addEventListener(
			'load',
			() => {
				if (reduce || autoRunning) return;
				const my = maxY();
				if (my >= MIN_SCROLL_RANGE && currentY() < my - 2) startAuto();
			},
			{ once: true }
		);
	})();
</script>

<style is:global>
	/* Autocontenido: funciona en home (con tokens) y en ebooks legacy (fallbacks). */
	.vc-autoscroll {
		position: fixed;
		z-index: 2147483000;
		right: max(0.65rem, env(safe-area-inset-right, 0px));
		bottom: max(0.75rem, env(safe-area-inset-bottom, 0px));
		width: min(10.5rem, 88vw);
		padding: 0.55rem 0.65rem 0.6rem;
		border-radius: var(--radius-md, 16px);
		border: 1px solid var(--line, rgba(74, 55, 40, 0.12));
		background: rgba(253, 249, 244, 0.94);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		box-shadow: 0 12px 36px rgba(42, 38, 34, 0.14);
		font-size: 0.68rem;
		color: var(--muted, #5c544c);
		touch-action: manipulation;
	}

	.vc-autoscroll__title {
		margin: 0 0 0.4rem;
		font-size: 0.62rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--text, #2a2622);
		text-align: center;
	}

	.vc-autoscroll__toggle {
		display: block;
		width: 100%;
		margin-bottom: 0.45rem;
		padding: 0.42rem 0.5rem;
		font: inherit;
		font-size: 0.62rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: #1f1c18;
		border: 1px solid rgba(183, 159, 92, 0.55);
		border-radius: 999px;
		background: linear-gradient(135deg, #e8d49a, #d4bc6e);
		cursor: pointer;
		transition: transform 0.12s ease, box-shadow 0.12s ease;
	}

	.vc-autoscroll__toggle:hover {
		transform: translateY(-1px);
		box-shadow: 0 4px 14px rgba(183, 159, 92, 0.35);
	}

	.vc-autoscroll__volume {
		display: flex;
		align-items: center;
		gap: 0.35rem;
		margin-bottom: 0.35rem;
	}

	.vc-autoscroll__step {
		flex: 0 0 auto;
		width: 1.85rem;
		height: 1.85rem;
		padding: 0;
		font-size: 1.15rem;
		font-weight: 600;
		line-height: 1;
		color: var(--text, #2a2622);
		border: 1px solid var(--line, rgba(74, 55, 40, 0.12));
		border-radius: 10px;
		background: rgba(255, 252, 248, 0.98);
		cursor: pointer;
		transition: background 0.12s ease, border-color 0.12s ease;
	}

	.vc-autoscroll__step:hover {
		border-color: rgba(183, 159, 92, 0.45);
		background: #fff;
	}

	.vc-autoscroll__range {
		flex: 1 1 auto;
		min-width: 0;
		height: 1.35rem;
		accent-color: var(--gold-dark, #b79f5c);
		cursor: pointer;
	}

	.vc-autoscroll__hint {
		margin: 0;
		font-size: 0.58rem;
		line-height: 1.35;
		letter-spacing: 0.04em;
		text-align: center;
		color: rgba(92, 84, 76, 0.88);
	}

	.vc-autoscroll__sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	@media (prefers-reduced-motion: reduce) {
		.vc-autoscroll {
			display: none !important;
		}
	}
</style>
